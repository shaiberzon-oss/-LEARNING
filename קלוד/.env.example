# === REQUIRED ===
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === OPTIONAL ===
# YouTube Data API v3 key (for playlist imports)
# Get it at: https://console.cloud.google.com/ → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
